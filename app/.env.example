# ───────────── ویستا — پیکربندی ─────────────
# پورت سرور (وب‌کلاینت ساخته‌شده هم از همین‌جا سرو می‌شود)
PORT=8787
# آدرس عمومی که کاربران با آن به ویستا می‌رسند (برای لینک‌های اشتراک‌گذاری و پیامک)
PUBLIC_URL=http://localhost:8787
# اتصال پایگاه‌داده PostgreSQL
DATABASE_URL=postgres://vista:vista@localhost:5432/vista
# کلید مخفی سکو (برای نشست‌ها و امضای پلهٔ ۱). در استقرار واقعی حتماً عوض شود.
PLATFORM_SECRET=change-me-in-production

# ───────────── پیامک (رمز یک‌بارمصرف و امضای پلهٔ ۲) ─────────────
# console  → کد در لاگ سرور چاپ می‌شود و (اگر DEV_SHOW_OTP=true) در رابط هم نشان داده می‌شود
# kavenegar → پنل کاوه‌نگار
# smsir     → پنل sms.ir
# http      → هر پنل دیگری با یک درخواست HTTP قابل‌تنظیم
SMS_PROVIDER=console
# هر کدی پذیرفته شود (فقط برای محیط آزمایشی، وقتی پنل پیامکی هنوز وصل نیست)
OTP_ACCEPT_ANY=false
DEV_SHOW_OTP=true
# کاوه‌نگار
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=
KAVENEGAR_SENDER=
# sms.ir
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=
SMSIR_LINE_NUMBER=
# پنل عمومی HTTP: در URL و BODY از {phone} و {message} استفاده کنید
SMS_HTTP_URL=
SMS_HTTP_METHOD=POST
SMS_HTTP_HEADERS={"content-type":"application/json"}
SMS_HTTP_BODY={"to":"{phone}","text":"{message}"}

# ───────────── مدل زبانی (رابط سازگار با OpenAI) ─────────────
# اگر خالی باشد، دستیار «در دسترس نیست» و بقیهٔ اپ‌ها مستقیم کار می‌کنند.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# حداکثر دور ابزار در هر پیام
AI_MAX_TOOL_ROUNDS=8

# ───────────── احراز هویت ─────────────
# شاهکار (تطبیق کد ملی و شماره): فعلاً mock → همیشه تطبیق دارد
SHAHKAR_PROVIDER=mock
# استعلام نام از روی شماره: فعلاً down → از کاربر پرسیده می‌شود
NAME_LOOKUP_PROVIDER=down

# ───────────── درگاه پرداخت ─────────────
# fake → درگاه آزمایشی با دو دکمهٔ موفق/ناموفق (بعداً با درگاه واقعی جایگزین می‌شود)
PAYMENT_GATEWAY=fake

# ───────────── اپ نمونهٔ مرجع (خدمات ایرانسل — شبیه‌سازی‌شده) ─────────────
SAMPLE_APP_ENABLED=true
